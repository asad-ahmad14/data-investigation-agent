# Copy to .env and edit. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (Docker Compose defaults; change passwords outside local dev) ---
POSTGRES_DB=retail_investigator
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application role (read/write on the `app` schema only) - created in Phase 3
APP_DB_USER=app_rw
APP_DB_PASSWORD=change-me-app-rw
# Analyst role (SELECT on approved `retail` tables only) - created in Phase 3
ANALYST_DB_USER=analyst_ro
ANALYST_DB_PASSWORD=change-me-analyst-ro

# --- LLM (Phase 4) ---
# mock = deterministic scripted model, no API key needed. Other value: gemini
LLM_PROVIDER=mock
LLM_MODEL=gemini-3.6-flash
# Leave empty in mock mode. Put your key here, never in chat or in git.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_REPAIRS=1
LLM_MAX_OUTPUT_TOKENS=4096

# Host port for the Docker api container (8001 avoids clashing with other local projects on 8000)
API_PORT=8001

# --- Investigation limits ---
MAX_ITERATIONS=3
MAX_STEPS_PER_PLAN=6
MAX_TOTAL_QUERIES=12
MAX_LLM_CALLS=8
MAX_ACTIVE_INVESTIGATIONS=4
RATE_LIMIT_PER_MINUTE=20
MAX_BODY_BYTES=16384
MAX_RESULT_ROWS=500
QUERY_TIMEOUT_MS=5000
INVESTIGATION_TIMEOUT_SECONDS=90
MAX_QUESTION_LENGTH=500
